@page "/auth/login"
@page "/auth/access-denied"
@page "/auth/error"
@page "/auth/signed-out"
@layout AccountLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>@Title — Vakthund</PageTitle>
<h1 class="font-display text-2xl font-semibold text-gray-100">@Title</h1>
<p class="mt-3 text-sm leading-6 text-gray-400">@Message</p>

@if (AuthenticationOptions.Value.Enabled)
{
    <form method="post" action="auth/sign-in" data-enhance="false" class="mt-6">
        <AntiforgeryToken/>
        <input type="hidden" name="returnUrl" value="@ReturnUrl"/>
        <button type="submit" class="w-full rounded-lg bg-amber-500 px-4 py-3 text-sm font-semibold text-gray-950 transition-colors hover:bg-amber-400">
            Continue to sign in
        </button>
    </form>
}
else
{
    <a href="" class="mt-6 inline-block text-sm text-amber-500 hover:text-amber-400">Return to dashboard</a>
}
