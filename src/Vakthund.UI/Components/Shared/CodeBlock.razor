@inject IJSRuntime JS
@implements IDisposable

<pre class="overflow-x-auto rounded border border-gray-800 bg-gray-950 p-3 font-mono text-xs leading-relaxed"><code @ref="_codeRef" class="language-@_language">@_formatted</code></pre>

@code {
    [Parameter, EditorRequired] public string Content { get; set; } = "";
    [Parameter] public string? Language { get; set; }
    [Parameter] public string? ContentType { get; set; }

    private ElementReference _codeRef;
    private string _formatted = "";
    private string _language = "plaintext";
    private readonly CancellationTokenSource _cts = new();

    protected override void OnParametersSet()
    {
        if (Language is not null)
        {
            _formatted = Content;
            _language = Language;
            return;
        }

        string? hinted = ContentType is not null ? ContentTypeToLanguage(ContentType) : null;
        (_formatted, _language) = FormatAndDetect(Content, hinted);
    }

    private static string? ContentTypeToLanguage(string contentType)
    {
        string baseType = contentType.Split(';')[0].Trim().ToLowerInvariant();
        return baseType switch
        {
            "application/json" or "text/json" => "json",
            "application/xml" or "text/xml" or "application/xhtml+xml" => "xml",
            "text/html" => "html",
            "text/css" => "css",
            "application/javascript" or "text/javascript" => "javascript",
            _ => null
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("hljs.highlightElement", _cts.Token, _codeRef);
            }
            catch
            {
            }
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private static (string Formatted, string Language) FormatAndDetect(string raw, string? hintedLanguage)
    {
        ReadOnlySpan<char> trimmed = raw.AsSpan().TrimStart();

        if (hintedLanguage is "json" || (hintedLanguage is null && (trimmed.StartsWith("{") || trimmed.StartsWith("["))))
        {
            try
            {
                using JsonDocument doc = JsonDocument.Parse(raw);
                return (JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true }), "json");
            }
            catch { }
        }

        if (hintedLanguage is "xml" || (hintedLanguage is null && trimmed.StartsWith("<")))
        {
            try
            {
                return (XDocument.Parse(raw).ToString(), "xml");
            }
            catch { }
        }

        return (raw, hintedLanguage ?? "plaintext");
    }
}
