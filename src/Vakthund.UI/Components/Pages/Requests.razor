@page "/requests"
@using Vakthund.Shared.Models
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="mx-auto max-w-7xl space-y-4 px-6 py-6">
    <header class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="font-display text-2xl font-semibold text-gray-100">Requests</h1>
            @if (MaxAuditEntries > 0)
            {
                <p class="mt-1 text-sm text-gray-500">@VisibleEntries.Count() of @_entries.Count captured requests</p>
                <p class="mt-1 text-xs text-gray-600">
                    This page keeps up to the latest @MaxAuditEntries.ToString("N0") requests. Older requests are removed
                    from the table when that limit is reached.
                </p>
            }
        </div>
        <div class="flex w-full flex-wrap items-center gap-3 md:w-auto">
            <input @bind="_searchText"
                   @bind:event="oninput"
                   class="w-full rounded border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-gray-100 outline-none transition-colors placeholder:text-gray-600 focus:border-amber-500 md:w-96"
                   placeholder="Filter by method, status, host, path, or query"/>
            <button @onclick="RefreshAsync"
                    class="@(_hasNewRequests ? "btn-refresh-pending" : "") flex items-center gap-1.5 rounded border border-amber-600 px-3 py-2 text-sm font-medium text-amber-400 transition-colors hover:border-amber-400 hover:text-amber-300 active:scale-95 active:border-amber-300 active:text-amber-200 transition-transform">
                <span class="material-symbols-outlined text-base @(_hasNewRequests ? "animate-spin-slow" : "")">refresh</span>
                Refresh
            </button>
        </div>
    </header>

    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2">
            <button @onclick="TryDeleteSelectedAsync"
                    disabled="@(SelectedCount == 0)"
                    class="inline-flex items-center gap-1.5 rounded border border-red-800 px-2.5 py-1.5 text-xs font-medium text-red-400 transition-colors hover:border-red-600 hover:text-red-300 disabled:cursor-not-allowed disabled:opacity-40">
                <span class="material-symbols-outlined text-base">delete</span>
                Delete selected
            </button>
            @if (SelectedCount > 0)
            {
                <span class="text-xs text-gray-500">@SelectedCount.ToString("N0") selected</span>
            }
        </div>

        <div class="ml-auto flex flex-wrap items-center justify-end gap-2">
            <span class="text-xs text-gray-600">View</span>
            <select value="@_activeProfileName" @onchange="OnProfileChangedAsync"
                    class="rounded border border-gray-700 bg-gray-950 px-2 py-1.5 text-sm text-gray-300 outline-none transition-colors focus:border-amber-500">
                <option value="@DefaultProfileName">@DefaultProfileName</option>
                @foreach (string name in _profiles.Keys.Where(k => k != DefaultProfileName).Order())
                {
                    <option value="@name">@name</option>
                }
                <option value="__create__">＋ Create view</option>
            </select>
            <button @onclick="SaveCurrentLayoutAsync"
                    title="Save current layout to this view"
                    class="text-gray-500 transition-colors hover:text-amber-400">
                <span class="material-symbols-outlined text-xl">save</span>
            </button>
            @if (_activeProfileName != DefaultProfileName)
            {
                <button @onclick="TryDeleteProfileAsync"
                        title="Delete this view"
                        class="text-gray-500 transition-colors hover:text-red-400">
                    <span class="material-symbols-outlined text-xl">delete</span>
                </button>
            }
        </div>
    </div>

    <div class="overflow-hidden rounded-lg border border-gray-700 bg-gray-900">
        <RadzenDataGrid @key="_activeProfileName" @ref="_grid" @bind-Settings="@Settings" Data="@VisibleEntries" TItem="AuditEntry"
                        @bind-Value="@_selectedEntries" SelectionMode="DataGridSelectionMode.Multiple" AllowRowSelectOnRowClick="true"
                        AllowSorting="true" AllowPaging="true"
                        PageSize="10" PageSizeOptions="_pageSizeOptions"
                        EmptyText="No matching requests." AllowColumnResize="true" AllowColumnReorder="true"
                        PagerAlwaysVisible="true" AllowFiltering="true" AllowGrouping="true">
            <Columns>
                <RadzenDataGridColumn TItem="AuditEntry" UniqueID="Select" Sortable="false" Filterable="false" Groupable="false" Reorderable="false" Width="48px">
                    <HeaderTemplate>
                        <RadzenCheckBox TValue="bool"
                                        TriState="false"
                                        Value="@AreAllVisibleSelected"
                                        Change="@ToggleSelectAllVisible"/>
                    </HeaderTemplate>
                    <Template Context="entry">
                        <RadzenCheckBox TValue="bool"
                                        TriState="false"
                                        Value="@IsEntrySelected(entry)"
                                        Change="@((bool selected) => ToggleEntrySelection(entry, selected))"
                                        @onclick:stopPropagation="true"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AuditEntry" UniqueID="Open" Sortable="false" Filterable="false" Groupable="false" Reorderable="false" Width="56px">
                    <Template Context="entry">
                        <a href="/request/@entry.Id" class="flex items-center justify-center text-amber-600 transition-colors hover:text-amber-400" title="Open">
                            <span class="material-symbols-outlined text-lg">open_in_new</span>
                        </a>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AuditEntry" Property="Timestamp" Title="Time" Width="150px">
                    <Template Context="entry">
                        <span
                            class="font-mono text-xs text-gray-400">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AuditEntry" Property="Method" Title="Method" Width="110px">
                    <Template Context="entry">
                        <span class="w-fit rounded px-2 py-1 text-xs font-bold text-white @HttpStyle.MethodColor(entry.Method)">@entry.Method</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AuditEntry" Property="StatusCode" Title="Status" Width="95px">
                    <Template Context="entry">
                        <span
                            class="rounded px-2 py-1 text-xs font-bold @HttpStyle.StatusColor(entry.StatusCode)">@entry.StatusCode</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AuditEntry" Property="Host" Title="Host" Width="180px">
                    <Template Context="entry">
                        <span class="font-mono text-sm text-gray-300">@entry.Host</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AuditEntry" Title="Target">
                    <Template Context="entry">
                        <div class="min-w-0">
                            <div class="truncate font-mono text-sm text-gray-100">@entry.Path</div>
                            @if (!string.IsNullOrWhiteSpace(entry.Query))
                            {
                                <div class="truncate font-mono text-xs text-gray-500">@entry.Query</div>
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AuditEntry" Property="DurationMs" Title="Duration" Width="110px">
                    <Template Context="entry">
                        <span class="font-mono text-sm text-gray-300">@entry.DurationMs ms</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AuditEntry" Property="TargetDurationMs" Title="Target" Width="110px">
                    <Template Context="entry">
                        <span
                            class="font-mono text-sm text-gray-300">@(entry.TargetDurationMs.HasValue ? $"{entry.TargetDurationMs} ms" : "-")</span>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

