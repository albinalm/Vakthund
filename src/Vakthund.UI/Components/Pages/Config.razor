@page "/config"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="mx-auto max-w-4xl space-y-4 px-6 py-6">

    <h1 class="font-display text-xl font-semibold text-gray-100">Configuration</h1>

    <Section Title="UI" Expanded="_uiExpanded" OnToggle="ToggleUi">
        <div class="grid grid-cols-1 gap-3 p-4 md:grid-cols-2">
            <div class="rounded border border-gray-800 bg-gray-950 p-3">
                <div class="text-xs text-gray-500">Audit Hub URL</div>
                <div class="mt-1 truncate font-mono text-sm @AuditHubTextClass">
                    @FormatOptional(AuditHubUrl, "Not configured")
                </div>
            </div>
            <div class="rounded border border-gray-800 bg-gray-950 p-3">
                <div class="text-xs text-gray-500">Storage Mode</div>
                <div class="mt-1 font-mono text-sm text-gray-200">@UiConfig.StorageMode</div>
            </div>
            <div class="rounded border border-gray-800 bg-gray-950 p-3">
                <div class="text-xs text-gray-500">Max Stored Entries</div>
                <div class="mt-1 font-mono text-sm text-gray-200">@FormatEntryLimit(UiConfig.MaxStoredAuditEntries)</div>
            </div>
            <div class="rounded border border-gray-800 bg-gray-950 p-3">
                <div class="text-xs text-gray-500">Storage Path</div>
                <div class="mt-1 truncate font-mono text-sm @StoragePathTextClass">
                    @FormatStoragePath(UiConfig)
                </div>
            </div>
            <div class="rounded border border-gray-800 bg-gray-950 p-3">
                <div class="text-xs text-gray-500">Retention</div>
                <div class="mt-1 font-mono text-sm @RetentionTextClass">@FormatRetention(UiConfig)</div>
            </div>
        </div>
    </Section>

    @if (_loading)
    {
        <div class="rounded-lg border border-gray-700 bg-gray-900 p-8 text-center text-sm text-gray-500">
            Loading...
        </div>
    }
    else if (_errorMessage is not null)
    {
        <div class="rounded-lg border border-red-800 bg-red-950/50 p-8 text-center">
            <h2 class="font-display text-lg font-semibold text-red-400">Failed to load proxy configuration</h2>
            <p class="mt-2 text-sm text-red-400">@_errorMessage</p>
            @if (_errorDetail is not null)
            {
                <p class="mt-3 font-mono text-xs text-gray-500">@_errorDetail</p>
            }
        </div>
    }
    else if (_config is not null)
    {
        <Section Title="Routes" Count="_config.Routes.Count" Expanded="_routesExpanded" OnToggle="ToggleRoutes">
            <div class="divide-y divide-gray-800">
                @foreach (var route in _config.Routes)
                {
                    <div class="grid grid-cols-1 gap-2 px-4 py-3 text-sm md:grid-cols-2">
                        <span class="font-mono text-gray-400">@route.Path</span>
                        <div class="min-w-0">
                            <div class="truncate font-mono text-gray-200">@route.Target</div>
                            @if (!string.IsNullOrWhiteSpace(route.To))
                            {
                                <div class="mt-1 truncate font-mono text-xs text-gray-500">to @route.To</div>
                            }
                            @if (route.Auth is not null)
                            {
                                <div class="mt-2 flex flex-wrap gap-2">
                                    @if (route.Auth.Enforced)
                                    {
                                        <span class="rounded border border-emerald-700 px-1.5 py-0.5 font-mono text-xs text-emerald-400">enforced</span>
                                    }
                                    @if (route.Auth.Issuer is not null)
                                    {
                                        <span class="rounded border border-gray-700 px-1.5 py-0.5 font-mono text-xs text-gray-500">iss @route.Auth.Issuer</span>
                                    }
                                    @if (route.Auth.Audience is not null)
                                    {
                                        <span class="rounded border border-gray-700 px-1.5 py-0.5 font-mono text-xs text-gray-500">aud @route.Auth.Audience</span>
                                    }
                                    @foreach (string audience in route.Auth.Audiences ?? [])
                                    {
                                        <span class="rounded border border-gray-700 px-1.5 py-0.5 font-mono text-xs text-gray-500">aud @audience</span>
                                    }
                                    @foreach (string scope in route.Auth.Scopes ?? [])
                                    {
                                        <span class="rounded border border-gray-700 px-1.5 py-0.5 font-mono text-xs text-gray-500">scope @scope</span>
                                    }
                                    @foreach (string role in route.Auth.Roles ?? [])
                                    {
                                        <span class="rounded border border-gray-700 px-1.5 py-0.5 font-mono text-xs text-gray-500">role @role</span>
                                    }
                                    @if (route.Auth.Jwe?.KeyType.HasValue == true)
                                    {
                                        <span class="rounded border border-violet-600 px-1.5 py-0.5 font-mono text-xs text-violet-400">jwe @route.Auth.Jwe!.KeyType.Value</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </Section>

        <Section Title="Capture" Expanded="_captureExpanded" OnToggle="ToggleCapture">
            <div class="grid grid-cols-1 gap-3 p-4 md:grid-cols-2">
                <div class="rounded border border-gray-800 bg-gray-950 p-3">
                    <div class="text-xs text-gray-500">Request Body</div>
                    <div class="mt-1 font-mono text-sm @(_config.MaxBodyBytes == 0 ? "text-gray-600" : "text-gray-200")">
                        @FormatBytes(_config.MaxBodyBytes)
                    </div>
                </div>
                <div class="rounded border border-gray-800 bg-gray-950 p-3">
                    <div class="text-xs text-gray-500">Response Body</div>
                    <div class="mt-1 font-mono text-sm @(_config.MaxResponseBodyBytes == 0 ? "text-gray-600" : "text-gray-200")">
                        @FormatBytes(_config.MaxResponseBodyBytes)
                    </div>
                </div>
            </div>
        </Section>

        <Section Title="Queue" Expanded="_queueExpanded" OnToggle="ToggleQueue">
            <div class="p-4">
                <div class="rounded border border-gray-800 bg-gray-950 p-3">
                    <div class="text-xs text-gray-500">Max Queued Entries</div>
                    <div class="mt-1 font-mono text-sm text-gray-200">@_config.MaxQueuedEntries.ToString("N0")</div>
                </div>
            </div>
        </Section>
    }
</div>
