@page "/request/{Id:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Vakthund.Shared.Models


@if (_entry is null)
{
    <div class="mx-auto flex h-96 max-w-3xl items-center justify-center px-6">
        <div class="rounded-lg border border-gray-700 bg-gray-900 p-8 text-center">
            <h1 class="font-display text-xl font-semibold text-gray-100">Request not found</h1>
            <p class="mt-2 text-sm text-gray-500">The request may have been captured before this UI session started.</p>
            <button @onclick="NavigateBack"
                    class="mt-5 rounded border border-gray-700 px-3 py-2 text-sm font-medium text-gray-300 transition-colors hover:border-amber-500 hover:text-amber-500">
                Back to requests
            </button>
        </div>
    </div>
}
else
{
    <div class="mx-auto max-w-6xl space-y-4 px-6 py-6">

        <button @onclick="NavigateBack"
                class="flex items-center gap-2 text-sm text-gray-400 hover:text-white transition-colors">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            Back
        </button>

        <div class="rounded-lg border border-gray-700 bg-gray-900 p-5">
            <div class="flex flex-wrap items-center gap-3">
                <span class="rounded px-2 py-1 text-xs font-bold text-white @HttpStyle.MethodColor(_entry.Method)">@_entry.Method</span>
                <span class="rounded px-2 py-1 text-xs font-bold @_statusColor">@_entry.StatusCode</span>
                <span class="text-sm text-gray-500">@_entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</span>
            </div>
            <h1 class="mt-4 break-all font-mono text-base text-gray-100">@_entry.Uri</h1>
            <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-4">
                <div class="rounded border border-gray-800 bg-gray-950 p-3">
                    <div class="text-xs text-gray-500">Duration</div>
                    <div class="mt-1 font-mono text-sm text-gray-200">@_entry.DurationMs ms</div>
                </div>
                <div class="rounded border border-gray-800 bg-gray-950 p-3">
                    <div class="text-xs text-gray-500">Target</div>
                    <div class="mt-1 font-mono text-sm text-gray-200">@(_entry.TargetDurationMs.HasValue ? $"{_entry.TargetDurationMs} ms" : "-")</div>
                </div>
                <div class="rounded border border-gray-800 bg-gray-950 p-3">
                    <div class="text-xs text-gray-500">Host</div>
                    <div class="mt-1 truncate font-mono text-sm text-gray-200">@_entry.Host</div>
                </div>
                <div class="rounded border border-gray-800 bg-gray-950 p-3">
                    <div class="text-xs text-gray-500">Scheme</div>
                    <div class="mt-1 font-mono text-sm text-gray-200">@_entry.Scheme</div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_entry.Body))
        {
            <Section Title="Request Body" Tag="@HttpStyle.ContentTypeShortName(_entry.ContentType)" Expanded="_bodyExpanded" OnToggle="ToggleBody">
                @if (IsFormEncoded(_entry.ContentType))
                {
                    <KeyValueTable Entries="@ParseFormEncoded(_entry.Body)" />
                }
                else
                {
                    <div class="p-3">
                        <CodeBlock Content="@_entry.Body" ContentType="@_entry.ContentType" />
                    </div>
                }
            </Section>
        }

        @if (!string.IsNullOrEmpty(_entry.ResponseBody))
        {
            <Section Title="Response Body" Tag="@HttpStyle.ContentTypeShortName(_entry.ResponseContentType)" Expanded="_responseBodyExpanded" OnToggle="ToggleResponseBody">
                @if (IsFormEncoded(_entry.ResponseContentType))
                {
                    <KeyValueTable Entries="@ParseFormEncoded(_entry.ResponseBody)" />
                }
                else
                {
                    <div class="p-3">
                        <CodeBlock Content="@_entry.ResponseBody" ContentType="@_entry.ResponseContentType" />
                    </div>
                }
            </Section>
        }

        @if (_entry.Queries.Count > 0)
        {
            <Section Title="Query Parameters" Count="_entry.Queries.Count" Expanded="_queriesExpanded" OnToggle="@ToggleQueries">
                <KeyValueTable Entries="_entry.Queries" />
            </Section>
        }

        @if (_authVerdict is not null)
        {
            <Section Title="Auth Verdict" Expanded="_authVerdictExpanded" OnToggle="ToggleAuthVerdict">
                <div class="space-y-4 p-4">
                    <div class="rounded border p-4 @AuthVerdictClasses(_authVerdict.Severity)">
                        <div class="flex flex-wrap items-center gap-3">
                            <span class="rounded border px-2 py-0.5 text-xs font-semibold @AuthVerdictBadgeClasses(_authVerdict.Severity)">
                                @_authVerdict.Severity
                            </span>
                            <div class="text-sm font-semibold">@_authVerdict.Title</div>
                        </div>
                        <p class="mt-2 text-sm">@_authVerdict.Detail</p>
                        @if (_authVerdict.Hints.Count > 0)
                        {
                            <ul class="mt-3 list-disc space-y-1 pl-5 text-xs">
                                @foreach (string hint in _authVerdict.Hints)
                                {
                                    <li>@hint</li>
                                }
                            </ul>
                        }
                    </div>

                    @if (_bearerToken?.Claims is not null)
                    {
                        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
                            @if (_bearerToken.Claims.Subject is not null)
                            {
                                <div class="rounded border border-gray-800 bg-gray-950 p-3">
                                    <div class="text-xs text-gray-500">Subject</div>
                                    <div class="mt-1 truncate font-mono text-sm text-gray-200">@_bearerToken.Claims.Subject</div>
                                </div>
                            }
                            @if (_bearerToken.Claims.Issuer is not null)
                            {
                                <div class="rounded border border-gray-800 bg-gray-950 p-3">
                                    <div class="text-xs text-gray-500">Issuer</div>
                                    <div class="mt-1 truncate font-mono text-sm text-gray-200">@_bearerToken.Claims.Issuer</div>
                                </div>
                            }
                            @if (_bearerToken.Claims.Audiences.Count > 0)
                            {
                                <div class="rounded border border-gray-800 bg-gray-950 p-3">
                                    <div class="text-xs text-gray-500">Audience</div>
                                    <div class="mt-1 truncate font-mono text-sm text-gray-200">@string.Join(", ", _bearerToken.Claims.Audiences)</div>
                                </div>
                            }
                            @if (_bearerToken.Claims.Scopes.Count > 0)
                            {
                                <div class="rounded border border-gray-800 bg-gray-950 p-3">
                                    <div class="text-xs text-gray-500">Scopes</div>
                                    <div class="mt-1 truncate font-mono text-sm text-gray-200">@string.Join(" ", _bearerToken.Claims.Scopes)</div>
                                </div>
                            }
                            @if (_bearerToken.Claims.Roles.Count > 0)
                            {
                                <div class="rounded border border-gray-800 bg-gray-950 p-3">
                                    <div class="text-xs text-gray-500">Roles</div>
                                    <div class="mt-1 truncate font-mono text-sm text-gray-200">@string.Join(", ", _bearerToken.Claims.Roles)</div>
                                </div>
                            }
                            @if (_bearerToken.Claims.ClientId is not null || _bearerToken.Claims.AuthorizedParty is not null)
                            {
                                <div class="rounded border border-gray-800 bg-gray-950 p-3">
                                    <div class="text-xs text-gray-500">Client</div>
                                    <div class="mt-1 truncate font-mono text-sm text-gray-200">@(_bearerToken.Claims.ClientId ?? _bearerToken.Claims.AuthorizedParty)</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </Section>
        }

        @if (_parsedTokens.Count > 0)
        {
            <Section Title="Tokens" Count="@(_parsedTokens.Count > 1 ? (int?)_parsedTokens.Count : null)" Expanded="_authExpanded" OnToggle="ToggleAuth">
                <div class="divide-y divide-gray-800">
                    @foreach (var token in _parsedTokens)
                    {
                        <div class="space-y-4 p-4">

                            <div class="flex flex-wrap items-center gap-3">
                                @if (token.HeaderName is not null)
                                {
                                    <span class="font-mono text-xs text-gray-500">@token.HeaderName</span>
                                }
                                @if (token.Scheme is not null)
                                {
                                    <span class="rounded border border-amber-600 px-2 py-0.5 text-xs font-semibold text-amber-400">@token.Scheme</span>
                                }
                                @if (token.IsJwe)
                                {
                                    <span class="rounded border border-violet-600 px-2 py-0.5 text-xs font-semibold text-violet-400">JWE</span>
                                }
                                @if (token.JwtExpiry.HasValue)
                                {
                                    <span class="rounded border @(token.JwtExpired ? "border-red-700 text-red-400" : "border-emerald-700 text-emerald-400") px-2 py-0.5 text-xs font-semibold">
                                        @(token.JwtExpired ? "Expired" : "Valid") · exp @token.JwtExpiry.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                    </span>
                                }
                            </div>

                            @if (token.IsJwe && token.JwtPayloadJson is null)
                            {
                                @if (token.JweDecryptError is not null)
                                {
                                    <div class="rounded border border-red-800 bg-red-950/50 p-3 text-xs text-red-400">
                                        <span class="font-semibold">Decryption failed: </span>@token.JweDecryptError
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded border border-gray-700 bg-gray-900 p-3 text-xs text-gray-500">
                                        Payload is encrypted — set <code class="font-mono text-gray-400">auth.jwe</code> on the matched route, or use the global <code class="font-mono text-gray-400">UI:JweFallback</code>.
                                    </div>
                                }
                            }

                            @if (token.JwtHeaderJson is not null || token.JwtPayloadJson is not null)
                            {
                                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                                    @if (token.JwtHeaderJson is not null)
                                    {
                                        <div>
                                            <div class="mb-1 text-xs font-medium text-gray-500">Header</div>
                                            <CodeBlock Content="@token.JwtHeaderJson" Language="json" />
                                        </div>
                                    }
                                    @if (token.JwtPayloadJson is not null)
                                    {
                                        <div>
                                            <div class="mb-1 text-xs font-medium text-gray-500">Payload</div>
                                            <CodeBlock Content="@token.JwtPayloadJson" Language="json" />
                                        </div>
                                    }
                                </div>
                            }

                            @if (token.BasicUsername is not null)
                            {
                                <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                                    <div class="rounded border border-gray-800 bg-gray-950 p-3">
                                        <div class="text-xs text-gray-500">Username</div>
                                        <div class="mt-1 font-mono text-sm text-gray-200">@token.BasicUsername</div>
                                    </div>
                                    @if (token.BasicPassword is not null)
                                    {
                                        <div class="rounded border border-gray-800 bg-gray-950 p-3">
                                            <div class="text-xs text-gray-500">Password</div>
                                            <div class="mt-1 font-mono text-sm text-gray-200">@token.BasicPassword</div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (token.RawToken is not null && token.JwtHeaderJson is null && token.BasicUsername is null)
                            {
                                <div>
                                    <div class="mb-1 text-xs font-medium text-gray-500">Token</div>
                                    <pre class="overflow-x-auto rounded border border-gray-800 bg-gray-950 p-3 font-mono text-xs text-gray-200 break-all whitespace-pre-wrap">@token.RawToken</pre>
                                </div>
                            }

                        </div>
                    }
                </div>
            </Section>
        }

        @if (_entry.Headers.Count > 0)
        {
            <Section Title="Headers" Count="_entry.Headers.Count" Expanded="_headersExpanded" OnToggle="@ToggleHeaders">
                <KeyValueTable Entries="_entry.Headers" />
            </Section>
        }

        @if (_entry.Cookies.Count > 0)
        {
            <Section Title="Cookies" Count="_entry.Cookies.Count" Expanded="_cookiesExpanded" OnToggle="@ToggleCookies">
                <KeyValueTable Entries="_entry.Cookies" />
            </Section>
        }

    </div>
}
